{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "noEmit": true
  },
  "include": ["*.ts", "*/*.ts"],
  "exclude": ["node_modules", "artifacts"]
}
